# UniBooks-DemoRecorder environment variable key list.
# This file lists key names only — no real values.
#
# Nothing here is required for a default local run: every key falls back to
# the value noted below. The one worth setting is UNIBOOKS_BE_DIR, without
# which the pre-recording cleanup is skipped and the video may show data left
# over from the previous run.

# Where the running app is served from.
# Unset = http://localhost:4200
DEMO_BASE_URL=

# Where finished .mp4 files are written. The raw/ subdirectory holds the webm
# intermediates ffmpeg reads.
# Unset = ./demo_videos inside this repository
DEMO_OUTPUT_DIR=

# ffmpeg executable, used to convert webm to mp4 and to concatenate the clips.
# Unset = "ffmpeg", resolved from PATH
FFMPEG_BIN=

# Path to a UniBooks-BE checkout. Used only to delete the listings, orders and
# conversations the previous recording created, via `manage.py shell`, so each
# run starts from the same state. No default on purpose: this repository does
# not sit beside the backend, and a guessed path would report a cleanup that
# silently did nothing. Unset = cleanup skipped, with a warning.
UNIBOOKS_BE_DIR=

# Python interpreter to run that cleanup with, relative to UNIBOOKS_BE_DIR.
# Unset = .venv/bin/python
UNIBOOKS_BE_PYTHON=

# The demo account the recording signs in as. It must already exist in the
# target database and be verified as a student, or the sell flow cannot run.
# Fictitious local-development values; never point this at a real account.
# Unset = test@test.com / Password123!
DEMO_EMAIL=
DEMO_PASSWORD=
