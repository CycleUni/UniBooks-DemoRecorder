# UniBooks-DemoRecorder environment variable key list.
# This file lists key names only — no real values.
#
# Nothing here is required for a default local run: every key falls back to a
# value describing the seeded development database this tool is shot against.
# The one worth setting is UNIBOOKS_BE_DIR, without which the pre-recording
# cleanup is skipped and the video may show data left over from the last run.

# ── Where the app is ────────────────────────────────────────────────────────

# Where the running app is served from.
# Unset = http://localhost:4200
DEMO_BASE_URL=

# The region segment every route is prefixed with (the app has no unprefixed
# URLs; /sell is always /<region>/sell).
# Unset = tw
DEMO_REGION=

# ── Where the output goes ───────────────────────────────────────────────────

# Root for everything this produces. Holds raw/ (the webm Playwright writes),
# scenes/ (one mp4 per take, plus scenes.json), cards/ (rasterised title
# cards), work/ (per-clip intermediates) and the finished film.
# Unset = ./demo_videos inside this repository
DEMO_OUTPUT_DIR=

# ffmpeg and ffprobe, used to convert takes, time them and cut them together.
# Unset = "ffmpeg" / "ffprobe", resolved from PATH
FFMPEG_BIN=
FFPROBE_BIN=

# The music bed. The cut is built to this track's tempo and phrase structure —
# see timeline.js, whose lengths are in bars — so pointing this at a different
# track means re-deciding those bar counts, not just changing the path. Not in
# version control: the repository has a licence to use the track, not to
# redistribute it. Missing, the film is cut silent and build-video.js says so.
# Unset = "Corporate Business Music.mp3" in this repository's root
DEMO_MUSIC=

# ── The backend, for cleanup and staging ────────────────────────────────────

# Path to a UniBooks-BE checkout. Used to delete the listing, order,
# conversation and waitlist subscription the previous recording created, so
# each run starts from the same state, and by scripts/stage-data.js. No
# default on purpose: this repository does not sit beside the backend, and a
# guessed path would report a cleanup that silently did nothing.
# Unset = cleanup skipped, with a warning; staging refuses to run
UNIBOOKS_BE_DIR=

# Python interpreter to run those with, relative to UNIBOOKS_BE_DIR.
# Unset = .venv/bin/python
UNIBOOKS_BE_PYTHON=

# Book title that identifies the load-test fixture scripts/stage-data.js hides
# before a shoot. Matched case-insensitively as a substring.
# Unset = Sample Book
DEMO_FIXTURE_TITLE=

# ── Who the recording follows ───────────────────────────────────────────────

# The account the camera follows: lists a book, then buys a different one. It
# must already exist in the target database and be verified in DEMO_REGION, or
# neither the sell flow nor the chat flow can run.
# Fictitious local-development values; never point this at a real account.
# Unset = test@test.com / Password123!
DEMO_EMAIL=
DEMO_PASSWORD=

# The counterparty, driven in a second unrecorded browser so that a reply
# arrives in the buyer's open chat window. Must be the seller of the listing
# DEMO_TARGET_ISBN resolves to, or there is no conversation to reply in.
# Unset = demo_tw_seller2@test.com / demopassword
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=

# ── What gets listed, in the seller act ─────────────────────────────────────

# The ISBN typed into the wizard. Pick one the lookup resolves to a title,
# author *and* cover art: the shot is about metadata appearing on its own, and
# an ISBN that comes back without a cover lands on the unjacketed-board
# placeholder, which reads as a failed lookup.
# Unset = 9780132350884 (Clean Code)
DEMO_SELL_ISBN=

# Title fragment identifying that listing, so the cleanup can find and delete
# it between runs. Must match what the lookup returns for DEMO_SELL_ISBN.
# Unset = Clean Code
DEMO_SELL_TITLE=

# The campus metadata typed in on step two, and the price on step three.
# Unset = 軟體工程 / 林教授 / 380
DEMO_SELL_COURSE=
DEMO_SELL_PROFESSOR=
DEMO_SELL_PRICE=

# ── What gets bought, in the buyer act ──────────────────────────────────────

# What gets typed into the search box. Worth choosing one whose results show
# both states at once — a book with a seller and a price, and a book with
# nobody selling and people waiting — since that single frame is the argument
# for the waitlist.
# Unset = Calculus
DEMO_SEARCH_QUERY=

# The book bought, and a fragment of its title used to pick its tile out of
# the search results.
# Unset = 9781285741550 / Early Transcendentals
DEMO_TARGET_ISBN=
DEMO_TARGET_TITLE=

# A book with no active listings, for the waitlist shot. The demo account must
# not already be subscribed to it — the cleanup unsubscribes between runs.
# Unset = 9780486404530 (Calculus)
DEMO_WAITLIST_ISBN=

# What the buyer types into the chat, and what the seller answers.
# Unset = a question about meeting at the main library, and a yes
DEMO_CHAT_BUYER=
DEMO_CHAT_SELLER=
